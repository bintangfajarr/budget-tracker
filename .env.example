# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed Telegram user IDs (security)
ALLOWED_USER_IDS=123456789

# Gmail IMAP
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# PostgreSQL
DATABASE_URL=postgresql://budget_user:password@localhost:5432/budget_tracker

# Email polling interval in minutes (default: 5)
EMAIL_POLL_INTERVAL=5

# ── Ollama / Nous Hermes AI Categorizer ──────────────────────────────────────
# Set AI_CATEGORIZE=false untuk disable AI dan hanya pakai keyword matching
AI_CATEGORIZE=true

# URL Ollama (default: localhost, tidak perlu diubah jika deploy di VPS yang sama)
OLLAMA_BASE_URL=http://localhost:11434

# Model name di Ollama (jalankan: ollama list untuk melihat model yang tersedia)
OLLAMA_MODEL=nous-hermes2-mistral

# Timeout request ke Ollama dalam detik (default: 15)
OLLAMA_TIMEOUT=15

