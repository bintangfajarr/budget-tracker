# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed Telegram user IDs (security)
ALLOWED_USER_IDS=123456789

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://budget_user:password@localhost:5432/budget_tracker

# ─── AI categorizer via OmniRoute (OpenAI-compatible gateway) ────────────────
# Replaces the previous local Ollama setup: no local model, no GPU, ~850ms.
AI_CATEGORIZE=true
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key
OMNIROUTE_MODEL=openrouter/cohere/north-mini-code:free
OMNIROUTE_TIMEOUT=30
# Reasoning models need room to think before emitting an answer. Too low a
# value returns content=null with the answer stranded in `reasoning`.
OMNIROUTE_MAX_TOKENS=800

# ─── Email import via Google Apps Script webhook ─────────────────────────────
# No Gmail credentials live on the server. Apps Script runs inside Google and
# POSTs parsed emails to /api/email-webhook authenticated with this secret.
EMAIL_WEBHOOK_SECRET=generate_with_openssl_rand_hex_24

# ─── Legacy IMAP polling (optional, superseded by the webhook above) ─────────
# GMAIL_ADDRESS=your_gmail@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password_here
# EMAIL_POLL_INTERVAL=5
